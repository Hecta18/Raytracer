// Step 0 smoke test: verifies the Zig + raylib toolchain, the GL context and the
// build/run wiring. Replaced by the real application in step 7.
const std = @import("std");
const rl = @import("raylib");

pub fn main(init: std.process.Init) !void {
    const arena = init.arena.allocator();
    const args = try init.minimal.args.toSlice(arena);

    // `--frames N` makes the smoke test exit on its own; without it the window
    // stays open until ESC or the close button.
    var frame_limit: ?u32 = null;
    var i: usize = 1;
    while (i < args.len) : (i += 1) {
        if (std.mem.eql(u8, args[i], "--frames") and i + 1 < args.len) {
            i += 1;
            frame_limit = try std.fmt.parseInt(u32, args[i], 10);
        } else {
            std.debug.print("unknown argument: {s}\n", .{args[i]});
        }
    }

    rl.setTraceLogLevel(.warning);
    rl.setConfigFlags(.{ .window_resizable = true });
    rl.initWindow(1280, 720, "diorama");
    defer rl.closeWindow();

    if (!rl.isWindowReady()) {
        std.debug.print("FAIL: raylib window is not ready\n", .{});
        return error.WindowInitFailed;
    }
    std.debug.print(
        "backend ok: window {d}x{d}, monitor {d} @{d}Hz\n",
        .{
            rl.getScreenWidth(),
            rl.getScreenHeight(),
            rl.getCurrentMonitor(),
            rl.getMonitorRefreshRate(rl.getCurrentMonitor()),
        },
    );

    var frames: u32 = 0;
    while (!rl.windowShouldClose() and !rl.isKeyDown(.escape)) {
        if (frame_limit) |limit| {
            if (frames >= limit) break;
        }
        frames += 1;

        rl.beginDrawing();
        defer rl.endDrawing();

        rl.clearBackground(.{ .r = 8, .g = 8, .b = 10, .a = 255 });
        rl.drawText("diorama: raylib toolchain OK", 20, 20, 20, .white);
        rl.drawFPS(20, 50);
    }

    std.debug.print("smoke test ok, {d} frames rendered\n", .{frames});
}